{
  "name": "mod_companion",
  "productName": "Mod Companion",
  "version": "1.0.0",
  "description": "Source Engine Modding Tool",
  "main": "build/main.js",
  "type": "module",
  "scripts": {
    "run-prod": "cross-env electron .",
    "run-vite": "cross-env NODE_ENV=development electron .",
    "dev:renderer": "vite --clearScreen false",
    "dev:main": "npm run prebuild & tsc --watch --project tsconfig.main.json",
    "dev": "concurrently -k -n MAIN,VITE -c green,blue,magenta \"npm:dev:main\" \"npm:dev:renderer\"",
    "build:main": "npm run prebuild & tsc --project tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main & npm run build:renderer",
    "prebuild": "copyfiles -u 1 ./src/*.js ./build/ & copyfiles ./main_assets/* ./build/",
    "deploy": "npm run build & node scripts/deploy.cjs"
  },
  "keywords": [],
  "author": {
    "name": "Stefan Heinz",
    "email": "stefan.heinz.02@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.1.2",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "electron": "36.2.0",
    "eslint": "^9.26.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vue": "^10.1.0",
    "fs-extra": "^11.3.0",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@nuxt/ui": "^3.1.1",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vueuse/core": "^13.2.0",
    "@vueuse/integrations": "^13.2.0",
    "async-validator": "^4.2.5",
    "change-case": "^5.4.4",
    "drauu": "^0.4.3",
    "electron-settings": "^4.0.4",
    "focus-trap": "^7.6.4",
    "idb-keyval": "^6.2.2",
    "jwt-decode": "^4.0.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.2",
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.6",
    "universal-cookie": "^7.2.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  }
}
