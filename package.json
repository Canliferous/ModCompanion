{
    "name": "mod_companion",
    "productName": "Mod Companion",
    "version": "1.0.0",
    "description": "Source Engine Modding Tool",
    "main": "build_dist/main.js",
    "type": "module",
    "keywords": [],
    "private": true,
    "author": {
        "name": "Second Face Software",
        "email": "hello@secondfacesoftware.com"
    },
    "license": "MIT",
    "scripts": {
        "run-dist": "cross-env electron build_dist/main/main.cjs",
        "run-dev": "cross-env NODE_ENV=development electron --inspect=9229 --trace-warnings build_dev/main/main.js",
        "dev": "npm run dev:assets && npm run dev:preload && concurrently -k -n MAIN,VITE -c green,magenta \"npm:dev:main\" \"npm:dev:renderer\"",
        "dev:main": "tsc --outDir build_dev --project src/main/tsconfig.json && concurrently \"tsc --watch --outDir build_dev --project src/main/tsconfig.json\" \"tsc-alias -w --outDir build_dev --project src/main/tsconfig.json\"",
        "dev:renderer": "vite --clearScreen false",
        "dev:assets": "copyfiles -u 1 main_assets/* build_dev/main_assets && copyfiles -u 1 main_assets/**/* build_dev/main_assets",
        "dev:preload": "esbuild ./src/preload.ts --bundle --platform=node --packages=external --outfile=./build_dev/preload.js",
        "build": "npm run build:assets && npm run build:preload && npm run build:main && npm run build:renderer",
        "build:main": "node ./scripts/build_main.mjs",
        "build:renderer": "vite build",
        "build:assets": "copyfiles -u 1 main_assets/* build_dist/main_assets && copyfiles -u 1 main_assets/**/* build_dist/main_assets",
        "build:preload": "esbuild ./src/preload.ts --bundle --platform=node --packages=external --outfile=./build_dist/preload.js",
        "build:docs": "typedoc --tsconfig src/main/tsconfig.json --entryPointStrategy Expand src/main src/shared",
        "deploy": "npm run build && node scripts/deploy.cjs",
        "test": "vitest",
        "lint": "eslint src",
        "lint-fix": "eslint src --fix"
    },
    "devDependencies": {
        "@electron/fuses": "^1.8.0",
        "@types/humanize-plus": "^1.8.2",
        "@types/lodash": "^4.17.19",
        "@typescript-eslint/eslint-plugin": "^8.32.0",
        "@typescript-eslint/parser": "^8.32.0",
        "@vitejs/plugin-vue": "^5.2.4",
        "concurrently": "^9.1.2",
        "copyfiles": "^2.4.1",
        "cross-env": "^7.0.3",
        "electron": "36.2.0",
        "esbuild": "^0.25.12",
        "eslint": "^9.26.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-vue": "^10.1.0",
        "fs-extra": "^11.3.0",
        "prettier": "^3.5.3",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "typedoc": "^0.28.7",
        "typescript": "^5.8.3",
        "vite": "^5.4.19",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.922.0",
        "@fontsource-variable/jetbrains-mono": "^5.2.5",
        "@fontsource/inter": "^5.2.5",
        "@nuxt/ui": "^3.3.3",
        "@sourcelib/kv": "^0.9.0",
        "@vue/eslint-config-typescript": "^14.5.0",
        "@vueuse/core": "^13.2.0",
        "@vueuse/integrations": "^13.2.0",
        "async-validator": "^4.2.5",
        "change-case": "^5.4.4",
        "chokidar": "^4.0.3",
        "dockview-vue": "^4.5.0",
        "drauu": "^0.4.3",
        "electron-settings": "^4.0.4",
        "exifreader": "^4.32.0",
        "focus-trap": "^7.6.4",
        "humanize-plus": "^1.8.2",
        "idb-keyval": "^6.2.2",
        "jwt-decode": "^4.0.0",
        "lodash": "^4.17.21",
        "nprogress": "^0.2.0",
        "pinia": "^3.0.2",
        "qrcode": "^1.5.4",
        "sortablejs": "^1.15.6",
        "universal-cookie": "^7.2.2",
        "uuid": "^11.1.0",
        "vue": "^3.5.13",
        "vue-router": "^4.5.1"
    }
}
