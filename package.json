{
  "name": "mod_companion",
  "productName": "mod_companion",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": "build/main.js",
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc --watch --project tsconfig.main.json",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:*\"",
    "build:renderer": "tsc --project tsconfig.main.json",
    "build:main": "vite build",
    "build": "concurrently -k \"npm:build:*\"",
    "deploy": "node scripts/deploy.cjs"
  },
  "keywords": [],
