{
    "compilerOptions": {
        "target": "ESNext",
        "module": "nodenext",
        "lib": ["DOM", "ESNext"],
        "strict": true,
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "outDir": "../../build_dist",
        "resolveJsonModule": true,
        "baseUrl": ".",
        "composite": true,
        "paths": {
            "~/*": ["./*"],
            "Shared/*": ["../shared/*"]
        },
        "inlineSources": true,
        "sourceMap": true
    },
    "include": ["."],
    "references": ["../shared"]
}
