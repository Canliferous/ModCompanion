{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "lib": ["DOM", "ES2021"],
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "../../build_dist",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/renderer/*"],
      "Shared/*": ["./src/shared/*"]
    }
  },
  "include": [".", "../../auto-imports.d.ts", "../../components.d.ts"]
}
