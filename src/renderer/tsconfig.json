{
    "compilerOptions": {
        "target": "ESNext",
        "module": "nodenext",
        "lib": ["DOM", "ESNext"],
        "strict": true,
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "outDir": "../../build",
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "~/*": ["./src/*"]
        },
        "inlineSources": true,
        "sourceMap": true
    },
    "include": ["."]
}
