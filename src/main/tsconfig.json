{
  "compilerOptions": {
    "outDir": "../../build_dist",
    "target": "ES2020",
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "strict": true,
    "lib": ["ESNext", "DOM"],
    "paths": {
      "Shared/*": ["../shared/*"]
    },
    "inlineSources": true,
    "sourceMap": true
  },
  "include": ["."]
}